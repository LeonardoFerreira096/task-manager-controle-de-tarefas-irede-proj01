<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.leonardo.taskmanager.controller.MainController"
            prefWidth="900" prefHeight="550">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <top>
        <GridPane hgap="10" vgap="8">
            <padding><Insets bottom="10"/></padding>
            <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtTitulo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Responsável:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtResponsavel" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Descrição:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtDescricao" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Prazo:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpPrazo" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Prioridade:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cbPrioridade" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Button fx:id="btnSalvar" text="Adicionar tarefa" onAction="#adicionarTarefa"
                    GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>
    </top>

    <center>
        <TableView fx:id="tabela">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="200"/>
                <TableColumn fx:id="colResponsavel" text="Responsável" prefWidth="140"/>
                <TableColumn fx:id="colPrazo" text="Prazo" prefWidth="110"/>
                <TableColumn fx:id="colPrioridade" text="Prioridade" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="130"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding><Insets top="10"/></padding>
            <Button text="Marcar como concluída" onAction="#concluirTarefa"/>
            <Button text="Remover" onAction="#removerTarefa"/>
            <Button text="Editar selecionada" onAction="#editarTarefa"/>
        </HBox>
    </bottom>
</BorderPane>